# Reuse the existing Ruvos Google OAuth client from google-chat-mcp.
# Add Docs scopes on that consent screen and this service's redirect URI.
# Do not create a second Google client. Never commit real values.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret

# Public URL of this service (no trailing slash)
# Local: http://localhost:8080
# Cloud Run: https://google-docs-mcp.ruvos.com
BASE_URL=https://google-docs-mcp.ruvos.com

# Generate new keys for THIS service (do not reuse Chat's, do not commit):
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SIGNING_KEY=

#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STORAGE_ENCRYPTION_KEY=

# Cloud Run (set automatically by platform)
PORT=8080
HOST=0.0.0.0

# Shared Redis, separate DB index from google-chat-mcp so DCR state does not collide.
# REDIS_URL=rediss://:AUTH@10.0.0.1:6378/1
# REDIS_CA_CERT=-----BEGIN CERTIFICATE----- ... -----END CERTIFICATE-----
# ALLOW_REDIS_INSECURE_TLS=1  # local/non-prod only; never on Cloud Run

# Optional: in-memory storage for local dev only
# USE_MEMORY_STORAGE=true

# OAuth scopes (configured in code — add to the existing Google OAuth consent screen):
#   openid
#   https://www.googleapis.com/auth/userinfo.email
#   https://www.googleapis.com/auth/documents
# Not requested: drive, drive.file, gmail, calendar.
# Add drive.file only if a Workspace parent folder is required later.
